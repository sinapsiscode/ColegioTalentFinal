# =====================================================
# CONFIGURACIÓN DE TALENTOS COLLEGE
# =====================================================
# Copia este archivo como .env y configura según tu ambiente
# NO SUBAS EL ARCHIVO .env A GIT

# =====================================================
# INFORMACIÓN DE LA APLICACIÓN
# =====================================================
VITE_APP_NAME=Talentos College
VITE_APP_VERSION=1.0.0
VITE_ACADEMIC_YEAR=2024

# =====================================================
# CONFIGURACIÓN DE API
# =====================================================
# URL base de la API backend
VITE_API_BASE_URL=http://localhost:3001/api

# Timeouts y reintentos
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3
VITE_API_RETRY_DELAY=1000

# =====================================================
# FEATURE FLAGS
# =====================================================
# Usar datos mock en lugar de API real
VITE_USE_MOCK=true

# Modo debug (más logs)
VITE_DEBUG=false

# Habilitar/deshabilitar funcionalidades
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_PAYMENTS=true
VITE_ENABLE_QR_SCANNER=true
VITE_ENABLE_EXPORTS=true
VITE_ENABLE_REAL_TIME=true
VITE_ENABLE_FILE_UPLOAD=true

# =====================================================
# SERVICIOS EXTERNOS
# =====================================================
# API para generar avatares
VITE_AVATAR_API=https://ui-avatars.com/api

# API para imágenes placeholder
VITE_PLACEHOLDER_API=https://via.placeholder.com

# API para generar códigos QR
VITE_QR_API=https://api.qrserver.com/v1/create-qr-code

# =====================================================
# AUTENTICACIÓN
# =====================================================
# Duración del token
VITE_JWT_EXPIRY=1h
VITE_REFRESH_TOKEN_EXPIRY=7d

# Duración de "Recordarme" (en días)
VITE_REMEMBER_ME_DAYS=7

# =====================================================
# ALMACENAMIENTO
# =====================================================
# Prefijo para las claves en localStorage
VITE_STORAGE_PREFIX=talentos_

# Configuración de backups
VITE_ENABLE_BACKUP=true
VITE_BACKUP_INTERVAL=300000
VITE_MAX_BACKUPS=10

# =====================================================
# INTERFAZ DE USUARIO
# =====================================================
# Tema de la aplicación
VITE_THEME=default

# Colores principales (en formato HEX)
VITE_PRIMARY_COLOR=#4F46E5
VITE_SECONDARY_COLOR=#7C3AED

# Paginación
VITE_ITEMS_PER_PAGE=10

# Archivos
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=image/jpeg,image/png,application/pdf

# =====================================================
# NOTIFICACIONES
# =====================================================
# Intervalo de verificación (en milisegundos)
VITE_NOTIFICATION_INTERVAL=60000

# Máximo de notificaciones a mostrar
VITE_MAX_NOTIFICATIONS=50

# =====================================================
# PAGOS
# =====================================================
# Moneda
VITE_CURRENCY=PEN
VITE_CURRENCY_SYMBOL=S/

# Métodos de pago permitidos
VITE_PAYMENT_METHODS=transferencia,deposito,efectivo

# Días de gracia para pagos
VITE_PAYMENT_GRACE_PERIOD=5

# =====================================================
# URLS Y ENLACES
# =====================================================
VITE_SUPPORT_EMAIL=soporte@talentos.edu.pe

# =====================================================
# DESARROLLO
# =====================================================
# Delay artificial para simular latencia de red (ms)
VITE_MOCK_DELAY=500

# Nivel de logs: debug, info, warn, error
VITE_LOG_LEVEL=debug